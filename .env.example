# ── Required ──────────────────────────────────────────────────
# Your Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Security ──────────────────────────────────────────────────
# API key for protecting endpoints (change before production)
API_KEY=your-secure-api-key-here

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" to skip API key checks for local demo evaluation only
DEMO_MODE=false

# ── Upload limits ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=20

# ── Frontend ──────────────────────────────────────────────────
# The backend URL the frontend will use (set for Docker)
VITE_API_URL=http://localhost:8002
VITE_API_KEY=your-secure-api-key-here
