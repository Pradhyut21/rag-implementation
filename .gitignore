# Project-wide .gitignore for the Agentic RAG Platform
# ─────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# ── Secrets & credentials (NEVER commit these) ────────
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.secrets.baseline
secrets.json
credentials.json
service-account*.json

# ── Test & Coverage ───────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
test-results/
bandit-report.json

# ── Type checking ─────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ── Data directories (contain user uploads / indexes) ─
agentic_rag_fastapi/data/
data/
*.index
*_chunks.pkl
observability.db
evaluation_report.json

# ── Docker ────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ── Node / Frontend ───────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.parcel-cache/

# ── OS / Editor ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.idea/
.vscode/settings.json
*.swp
*.swo
*~
.project
.classpath

# ── Jupyter notebooks checkpoints ────────────────────
.ipynb_checkpoints/

# ── Logs ─────────────────────────────────────────────
*.log
logs/
log/

# ── Temporary files ───────────────────────────────────
*.tmp
*.temp
*.bak
tmp/
temp/

# ── Deployment ────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
.serverless/
